# Application mode: demo until real integrations and database persistence are configured.
APP_MODE=demo

# Local services
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Google OAuth — create credentials in Google Cloud before enabling Gmail connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
FRONTEND_APP_URL=http://localhost:3000
GMAIL_INITIAL_SYNC_DAYS=60

# AI provider
OPENAI_API_KEY=

# Billing providers (webhook verification must be implemented server-side before use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# n8n and WhatsApp Business integration (use an opt-in workflow and signed webhooks).
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Required for signed sessions and encrypted Gmail refresh-token storage.
APP_SECRET_KEY=
