# Application mode: demo until real integrations and database persistence are configured.
APP_MODE=demo

# Local services
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Google OAuth — create credentials in Google Cloud before enabling Gmail connection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# AI provider
OPENAI_API_KEY=

# Billing providers (webhook verification must be implemented server-side before use).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Generate a high-entropy value before enabling sessions or token encryption.
APP_SECRET_KEY=
